# ── Databricks ────────────────────────────────────────────────────────────
# Local bundle state: deploy logs, lock files and cached workspace sync data
.databricks/

# ── Python ────────────────────────────────────────────────────────────────
# Build output: wheel artifacts go here (see dist/README.md)
build/
# Wheel build artifacts (generated by `uv build --wheel`)
dist/
# Python bytecode caches
__pycache__/
# Package metadata generated by setuptools
*.egg-info
# Project virtual environment managed by uv
.venv/

# ── Tooling caches / local & agent config ─────────────────────────────────
# ALL of these are also excluded from Databricks deploys by design:
# sync.paths in databricks.yml is a WHITELIST (src/, tasks/, resources/,
# fixtures/, pyproject.toml) — anything not listed is never uploaded.
# Ruff linter cache
.ruff_cache/
# Agent-local MCP/trust config (Pi project file)
.pi/
# Claude Code local state
.claude/
# VS Code workspace settings (personal, machine-specific)
.vscode/
# Operational context for AI agents is PART of this template: keep .agents/ in git.
# .claude/
# ── Secrets ───────────────────────────────────────────────────────────────
# Environment files: NEVER commit tokens (e.g. GITHUB_MCP_PAT, HF_TOKEN)
.env
.env.*
!.env.example

# ── Scratch / experiments ─────────────────────────────────────────────────
# Personal scratch area (only README.md is tracked)
scratch/**
!scratch/README.md
# Exploratory notebooks/code (only the README is tracked)
**/explorations/**
**/!explorations/README.md
# ── Stray artifacts ────────────────────────────────────────────────────────
# Compiled bytecode outside __pycache__ (e.g. pyc-only builds)
*.pyc
# Runtime / deploy logs
*.log
# macOS Finder metadata
.DS_Store
